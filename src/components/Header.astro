---
const nav = [
  { label: "Αρχική", href: "/" },
  { label: "Αμφίκλεια", href: "/amfikleia" },
  { label: "Διαδρομές", href: "/diadromes" },
  { label: "Σχετικά με εμάς", href: "/schetika-me-emas" },
  { label: "Επικοινωνία", href: "/epikoinonia" },
];

const social = [
  { label: "Facebook", href: "https://www.facebook.com/parnassoshikingclub", d: "M15 8h-2a1 1 0 0 0-1 1v2h3l-.5 3H12v7H9v-7H7v-3h2V9a4 4 0 0 1 4-4h2v3Z" },
  { label: "Instagram", href: "https://www.instagram.com/parnassoshikingclub", d: "M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2Zm0 7.6a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm5.9-7.8a1.07 1.07 0 1 1-2.15 0 1.07 1.07 0 0 1 2.15 0ZM16 4H8a4 4 0 0 0-4 4v8a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4V8a4 4 0 0 0-4-4Zm2.4 12a2.4 2.4 0 0 1-2.4 2.4H8A2.4 2.4 0 0 1 5.6 16V8A2.4 2.4 0 0 1 8 5.6h8A2.4 2.4 0 0 1 18.4 8v8Z" },
  { label: "TikTok", href: "https://www.tiktok.com/@parnassoshikingclub", d: "M16.5 5c.3 1.6 1.3 2.8 2.9 3v2.3a5.6 5.6 0 0 1-3-1v4.5a4.6 4.6 0 1 1-4.6-4.6c.2 0 .4 0 .6.05v2.4a2.2 2.2 0 1 0 1.6 2.15V5h2.5Z" },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/parnassos-hiking-club", d: "M8.3 18H6V9.8h2.3V18ZM7.1 8.7a1.35 1.35 0 1 1 0-2.7 1.35 1.35 0 0 1 0 2.7ZM18 18h-2.3v-4c0-.95-.02-2.18-1.33-2.18s-1.53 1.04-1.53 2.11V18H10.5V9.8h2.2v1.12h.03a2.42 2.42 0 0 1 2.18-1.2c2.33 0 2.76 1.54 2.76 3.53V18Z" },
];
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Parnassos Hiking Club — Αρχική">
      <img
        src="/images/icons/logo.png"
        alt="Λογότυπο Parnassos Hiking Club"
        width="160"
        height="201"
      />
    </a>

    <nav class="site-nav" aria-label="Κύρια πλοήγηση">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <ul class="site-social">
      {social.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={s.d} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .site-header {
    background: var(--c-white);
    border-bottom: 1px solid var(--c-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-height: 120px;
    padding-block: 12px;
  }

  .site-header__logo img {
    width: 88px;
    height: auto;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    font-size: 0.875rem;
    color: var(--c-shark);
    padding-block: 6px;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:hover {
    color: var(--c-cinnabar);
    border-bottom-color: var(--c-cinnabar);
  }

  .site-social {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-social a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--c-cinnabar);
  }

  .site-social a:hover { background: var(--c-daintree); }

  .site-social svg {
    width: 18px;
    height: 18px;
    fill: var(--c-white);
  }

  @media (max-width: 900px) {
    .site-header__inner { flex-wrap: wrap; min-height: 0; gap: 16px; }
    .site-nav { order: 3; width: 100%; }
    .site-nav ul { flex-wrap: wrap; gap: 16px; justify-content: center; }
    .site-header__logo img { width: 64px; }
  }
</style>
