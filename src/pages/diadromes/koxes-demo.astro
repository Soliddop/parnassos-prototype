---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrailStats from "../../components/TrailStats.astro";
import DemoBookingPanel from "../../components/DemoBookingPanel.astro";
import Gallery from "../../components/Gallery.astro";
import Faq from "../../components/Faq.astro";
import TrailCard from "../../components/TrailCard.astro";
import { trails, EQUIPMENT } from "../../data/trails";

const trail = trails.find((item) => item.slug === "koxes");
if (!trail) throw new Error("The Koxes trail fixture is missing.");

const related = trails.filter((item) => item.slug !== trail.slug).slice(0, 3);
const mapQuery = encodeURIComponent(`${trail.title} Παρνασσός`);
---

<BaseLayout
  title={`${trail.title} — Demo κράτησης — Parnassos Hiking Club`}
  description={trail.description[0]}
  image={trail.hero}
>
  <div class="shell">
    <div class="demo-banner" role="note">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20L12 3Zm0 6v5m0 3h.01" /></svg>
      <p><strong>Δοκιμαστική εμπειρία κράτησης.</strong> Οι αναχωρήσεις είναι ενδεικτικές και δεν αποστέλλεται παραγγελία.</p>
    </div>

    <figure class="hero">
      <img src={trail.hero} alt={trail.title} width="1598" height="527" fetchpriority="high" />
    </figure>
  </div>

  <div class="shell layout">
    <div class="layout__head">
      <nav class="crumbs" aria-label="Διαδρομή πλοήγησης">
        <a href="/">Αρχική</a> <span aria-hidden="true">/</span>
        <a href="/diadromes">Διαδρομές</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{trail.title} · Demo</span>
      </nav>

      <header class="intro">
        <h1 class="intro__title">{trail.title}</h1>
        <p class="intro__subtitle">{trail.subtitle}</p>
      </header>
    </div>

    <div class="layout__main">
      <section class="summary" aria-label="Περιγραφή και στοιχεία διαδρομής">
        <div class="summary__description">
          <h2 class="section-title">Περιγραφή</h2>
          {trail.description.map((paragraph) => <p class="block__text">{paragraph}</p>)}
        </div>
        <div class="summary__facts">
          <h2 class="section-title">Στοιχεία διαδρομής</h2>
          <TrailStats trail={trail} />
        </div>
      </section>

      <section class="block two-col" aria-label="Παρεχόμενα και προϋποθέσεις">
        <div>
          <h2 class="section-title">Παρεχόμενα</h2>
          <ul class="list list--check">
            {trail.includes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="section-title">{trail.requirementsHeading ?? "Προϋποθέσεις πεζοπορίας"}</h2>
          <ul class="list list--dot">
            {trail.requirements.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="block equipment" aria-labelledby="demo-equipment-title">
        <h2 id="demo-equipment-title" class="section-title">Απαραίτητος εξοπλισμός</h2>
        <ul class="list list--dot equipment__list">
          {EQUIPMENT.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="block" aria-label="Σημαντικές πληροφορίες">
        <div class="notice">
          <div class="notice__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 2 1 21h22L12 2Zm0 15a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Zm-1.1-8h2.2v6h-2.2V9Z" /></svg>
          </div>
          <div>
            <h2 class="notice__title">Σημαντικές Πληροφορίες</h2>
            <p class="notice__text">{trail.important}</p>
          </div>
        </div>
      </section>

      <section class="block" aria-label="Χάρτης διαδρομής">
        <h2 class="section-title">Χάρτης διαδρομής</h2>
        <div class="map">
          <iframe
            title={`Χάρτης — ${trail.title}`}
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </section>

      <Gallery images={trail.gallery} title={trail.title} />
      <Faq trail={trail} />
    </div>

    <div class="layout__side">
      <DemoBookingPanel trail={trail} />
    </div>
  </div>

  <section class="cta" aria-label="Κράτηση">
    <img class="cta__bg" src={trail.hero} alt="" aria-hidden="true" loading="lazy" />
    <div class="cta__inner">
      <h2 class="cta__title">{trail.title}</h2>
      <p class="cta__subtitle">{trail.subtitle}</p>
      <p class="cta__price">{trail.price}</p>
      <button class="btn btn--primary" type="button" data-demo-booking-open>Δείτε αναχωρήσεις</button>
    </div>
  </section>

  <section class="shell related" aria-label="Δείτε επίσης">
    <div class="related__head">
      <h2 class="section-title">Δείτε επίσης</h2>
      <a class="related__all" href="/diadromes">Δείτε όλα</a>
    </div>
    <div class="related__grid">
      {related.map((item) => <TrailCard trail={item} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .demo-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding: 12px 16px;
    border: 1px solid #f0c8be;
    border-radius: 8px;
    background: #fff7f3;
    color: #6b3a31;
  }

  .demo-banner svg {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--c-cinnabar);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .demo-banner p { margin: 0; font-size: 0.875rem; }

  .hero {
    margin: 20px 0 0;
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  .hero img {
    width: 100%;
    aspect-ratio: 1598 / 527;
    object-fit: cover;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 390px);
    gap: clamp(36px, 4vw, 64px);
    align-items: start;
    padding-top: 36px;
  }

  .layout__head { grid-column: 1; grid-row: 1; }
  .layout__main { grid-column: 1; grid-row: 2; }
  .layout__side { grid-column: 2; grid-row: 1 / span 2; align-self: stretch; }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
    font-size: 0.75rem;
    color: var(--c-boulder);
  }

  .crumbs a:hover { color: var(--c-cinnabar); }
  .intro__title { font-size: var(--fs-h4); font-weight: 700; }
  .intro__subtitle { margin: 6px 0 0; font-size: 1.0625rem; color: var(--c-dove-gray); }

  .summary {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    margin-top: 28px;
  }

  .block { margin-top: 48px; }
  .block__text { margin: 0 0 16px; line-height: 1.8; color: var(--c-dove-gray); }

  .two-col {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: var(--c-wild-sand);
  }

  .list { margin: 0; padding: 0; list-style: none; }

  .list li {
    position: relative;
    margin-bottom: 12px;
    padding-inline-start: 28px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--c-shark);
  }

  .list--check li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 3px;
    width: 16px;
    height: 16px;
    border: 2px solid var(--c-cinnabar);
    border-radius: 3px;
  }

  .list--check li::after {
    content: "";
    position: absolute;
    inset-inline-start: 5.5px;
    top: 6px;
    width: 5px;
    height: 9px;
    border-right: 2px solid var(--c-cinnabar);
    border-bottom: 2px solid var(--c-cinnabar);
    transform: rotate(45deg);
  }

  .list--dot li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 8px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-border);
  }

  .equipment__list { columns: 2; column-gap: 48px; }
  .equipment__list li { break-inside: avoid; }

  .notice {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--c-daintree);
  }

  .notice__icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--c-cinnabar);
  }

  .notice__icon svg { width: 25px; height: 25px; fill: var(--c-white); }
  .notice__title { font-size: 1.125rem; color: var(--c-white); }
  .notice__text { margin: 8px 0 0; line-height: 1.65; color: rgba(255, 255, 255, 0.95); }

  .map { border: 1px solid var(--c-border); border-radius: var(--radius-lg); overflow: clip; }
  .map iframe { display: block; width: 100%; height: 460px; border: 0; }

  .cta {
    position: relative;
    isolation: isolate;
    margin-top: 64px;
    padding: 72px 24px;
    overflow: clip;
    text-align: center;
  }

  .cta__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .cta::after { content: ""; position: absolute; inset: 0; z-index: -1; background: rgba(0, 42, 63, 0.76); }
  .cta__title { font-size: var(--fs-h5); font-weight: 700; color: var(--c-white); }
  .cta__subtitle { margin: 8px 0 0; color: rgba(255, 255, 255, 0.85); }
  .cta__price { margin: 18px 0; font-size: 2rem; font-weight: 700; color: var(--c-white); }

  .related { margin-top: 64px; }
  .related__head { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .related__head .section-title { margin-bottom: 0; }
  .related__all { padding: 6px 14px; border-radius: 4px; background: var(--c-cinnabar); color: var(--c-white); font-size: 0.75rem; font-weight: 700; }
  .related__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 20px; }

  @media (max-width: 1024px) {
    .layout { grid-template-columns: minmax(0, 1fr); gap: 30px; }
    .layout__head { grid-column: 1; grid-row: 1; }
    .layout__side { grid-column: 1; grid-row: 2; }
    .layout__main { grid-column: 1; grid-row: 3; }
    .summary { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .two-col { grid-template-columns: minmax(0, 1fr); gap: 32px; padding: 24px; }
    .related__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 700px) {
    .demo-banner { align-items: flex-start; }
    .demo-banner p { font-size: 0.8125rem; }
    .related__grid { grid-template-columns: minmax(0, 1fr); }
    .equipment__list { columns: 1; }
    .map iframe { height: 320px; }
    .notice { flex-direction: column; gap: 12px; padding: 22px; }
  }
</style>
