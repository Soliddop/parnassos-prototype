---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrailCard from "../components/TrailCard.astro";
import { trails } from "../data/trails";

const featured = trails.slice(0, 8);
---

<BaseLayout
  title="Parnassos Hiking Club — Πεζοπορία στον Παρνασσό"
  description="Πεζοπορία και φυσιολατρία στον Παρνασσό με πιστοποιημένους συνοδούς βουνού."
>
  <div class="shell">
    <header class="page-head">
      <h1>Πεζοπορία στον Παρνασσό</h1>
      <p>
        Εξερευνήστε τον Παρνασσό με πιστοποιημένους συνοδούς βουνού — από τον
        παραδοσιακό οικισμό της Αμφίκλειας ως την κορυφή της Λιάκουρας.
      </p>
      <a class="btn btn--primary" href="/diadromes">Δείτε όλες τις διαδρομές</a>
    </header>

    <h2 class="section-title">Δημοφιλείς διαδρομές</h2>
    <ul class="grid">
      {featured.map((trail) => (
        <li><TrailCard trail={trail} /></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-head { padding: 48px 0 40px; max-width: 720px; }
  .page-head h1 { font-size: var(--fs-h2); font-weight: 700; }
  .page-head p { margin: 16px 0 24px; line-height: 1.75; color: var(--c-dove-gray); }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1280px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
